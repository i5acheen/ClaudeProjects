---
import Icon from "./Icon.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import SectionHeading from "./SectionHeading.astro";
import { pricing, whatsappLink } from "../config/site";
---

<section id="pricing" class="section" aria-labelledby="pricing-title">
  <div class="container-x">
    <SectionHeading id="pricing-title" eyebrow={pricing.eyebrow} title={pricing.title} />
    <ul class="mt-12 grid gap-4 md:grid-cols-3">
      {pricing.items.map((p, i) => (
        <li class:list={["lift rounded-3xl border p-6 sm:p-7", i === 0 ? "border-teal-800 bg-teal-800 text-cream" : "border-line bg-white"]} data-reveal>
          <div class="flex items-center justify-between">
            <span class:list={["flex size-11 items-center justify-center rounded-xl", i === 0 ? "bg-saffron-400 text-ink" : "bg-teal-50 text-teal-700"]}><Icon name={p.icon} class="size-5" /></span>
            <span class:list={["rounded-full px-3 py-1 text-xs font-semibold", i === 0 ? "bg-cream/10 text-saffron-300" : "bg-saffron-100 text-saffron-700"]}>{p.tag}</span>
          </div>
          <h3 class:list={["mt-6 text-xl font-semibold", i === 0 ? "text-cream" : "text-teal-800"]}>{p.title}</h3>
          <p class:list={["mt-1", i === 0 ? "text-cream/75" : "text-muted"]}>{p.text}</p>
        </li>
      ))}
    </ul>
    <div class="mt-8 flex flex-col items-center gap-5 text-center" data-reveal>
      <p class="flex items-center gap-2 text-sm text-muted"><Icon name="Info" class="size-4 shrink-0 text-teal-600" />{pricing.note}</p>
      <a href={whatsappLink("Hi! I'd like a free quote for automating part of my business.")} target="_blank" rel="noopener" class="btn btn-whatsapp text-lg">
        <WhatsAppIcon class="size-6" /> {pricing.cta}
      </a>
    </div>
  </div>
</section>
