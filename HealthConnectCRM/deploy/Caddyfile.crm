{
	email {$ACME_EMAIL}
}

# The CRM
{$SITE_SCHEME}://{$APP_HOST} {
	encode zstd gzip
	reverse_proxy app:3000
}

# Supabase APIs the browser needs. Studio, pg-meta and everything else stay private (SSH tunnel).
{$SITE_SCHEME}://{$API_HOST} {
	@public path /auth/v1/* /rest/v1/* /realtime/v1/* /storage/v1/*
	handle @public {
		reverse_proxy api-gw:8000
	}
	handle {
		respond 404
	}
}

# Error tracking / uptime (GlitchTip has its own login; registration is disabled)
{$SITE_SCHEME}://{$ERRORS_HOST} {
	reverse_proxy errors:8000
}
