# Copy to .env.local for development. Production values live ONLY in Vercel env vars.
# Never commit real values. See docs/PRODUCTION.md for the full checklist.

# Supabase (production project: region ap-south-1 / Mumbai)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta Lead Ads
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=            # random string you choose
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=       # long-lived page token
META_GRAPH_VERSION=           # current Graph API version from Meta docs

# WhatsApp Cloud API
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=              # System User permanent token
WA_VERIFY_TOKEN=

# AI (paid/API tier only — no training on customer data)
AI_PROVIDER=none              # none = rules only (default). Later: anthropic | gemini | openai_compat
AI_MODEL=                     # optional override; default claude-opus-5-5 / gemini-2.5-flash / qwen3:8b
AI_BASE_URL=                  # openai_compat only, e.g. http://ollama:11434/v1
AI_API_KEY=                   # openai_compat only, if your model server needs one
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=       # optional: browser error reporting (same DSN)
SENTRY_AUTH_TOKEN=            # build-time only: source map upload
SENTRY_ORG=
SENTRY_PROJECT=

APP_BASE_URL=
