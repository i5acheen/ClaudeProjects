---
import Icon from "./Icon.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { hero, audience, whatsappLink, bookingLink } from "../config/site";
import { hl } from "../lib/text";
---

<section class="relative overflow-hidden bg-white">
  <div class="container-x relative pt-16 pb-14 text-center sm:pt-28 sm:pb-20">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1 class="mx-auto mt-5 max-w-4xl text-[2.6rem] leading-[1.08] font-bold tracking-tight text-ink sm:text-6xl lg:text-7xl" set:html={hl(hero.headline)} />
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">{hero.subhead}</p>
    <div class="mt-10 flex flex-col justify-center gap-3 sm:flex-row sm:gap-4">
      <a href={whatsappLink()} target="_blank" rel="noopener" class="btn btn-dark min-h-14 px-8 text-lg">
        <WhatsAppIcon class="size-5" />
        {hero.primaryCta}
      </a>
      <a href={bookingLink} target="_blank" rel="noopener" class="btn btn-lavender min-h-14 px-8 text-lg">
        <Icon name="CalendarCheck" class="size-5" />
        {hero.secondaryCta}
      </a>
    </div>
  </div>

  <!-- Who it's for: scrolling strip -->
  <div class="pb-14 sm:pb-20">
    <p class="text-center text-sm font-medium tracking-wider text-muted uppercase">{audience.label}</p>
    <div class="marquee mt-6 overflow-hidden">
      <ul class="marquee-track flex w-max gap-10 pr-10 sm:gap-14 sm:pr-14">
        {[...audience.items, ...audience.items].map((a, i) => (
          <li class="flex shrink-0 items-center gap-2.5 text-lg font-semibold text-gray-500" aria-hidden={i >= audience.items.length ? "true" : undefined}>
            <Icon name={a.icon} class="size-6 text-gray-400" />
            {a.label}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
