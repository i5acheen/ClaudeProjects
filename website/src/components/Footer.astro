---
import Logo from "./Logo.astro";
import { business, nav, footer, whatsappLink, bookingLink } from "../config/site";
const year = new Date().getFullYear();
---

<footer class="bg-teal-900 pb-28 text-cream/85 sm:pb-12">
  <div class="container-x grid gap-10 pt-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <Logo light />
      <p class="mt-4 max-w-sm leading-relaxed">{footer.blurb}</p>
    </div>
    <div>
      <h2 class="font-sans text-sm font-semibold tracking-wide text-saffron-300 uppercase">Explore</h2>
      <ul class="mt-3 grid grid-cols-2 gap-x-4 sm:grid-cols-1">
        {nav.map((i) => <li><a class="inline-flex min-h-10 items-center hover:text-white hover:underline" href={i.href}>{i.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="font-sans text-sm font-semibold tracking-wide text-saffron-300 uppercase">Contact</h2>
      <ul class="mt-3 space-y-1">
        <li><a class="inline-flex min-h-10 items-center hover:text-white hover:underline" href={whatsappLink()} target="_blank" rel="noopener">WhatsApp: {business.phoneDisplay}</a></li>
        <li><a class="inline-flex min-h-10 items-center break-all hover:text-white hover:underline" href={`mailto:${business.email}`}>{business.email}</a></li>
        <li><a class="inline-flex min-h-10 items-center hover:text-white hover:underline" href={bookingLink} target="_blank" rel="noopener">Book a free 20-min call</a></li>
        <li class="pt-1">{business.city}, {business.region} · Across India</li>
      </ul>
    </div>
  </div>
  <div class="container-x mt-12 flex flex-col gap-3 border-t border-cream/15 pt-6 text-sm sm:flex-row sm:items-center sm:justify-between">
    <p>© {year} {business.name}. All rights reserved.</p>
    <a href="/privacy" class="inline-flex min-h-10 items-center hover:text-white hover:underline">Privacy Policy</a>
  </div>
</footer>
