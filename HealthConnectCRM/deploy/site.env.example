# Copy to deploy/site.env and fill in, then run: sh deploy/setup.sh   (docs/SELF_HOSTING.md)
SITE_SCHEME=https                 # use http only for a local test
APP_HOST=crm.example.in           # the CRM
API_HOST=api.crm.example.in       # Supabase APIs (browser needs it)
ERRORS_HOST=errors.crm.example.in # GlitchTip error tracking + uptime
ADMIN_EMAIL=admin@example.in      # Let's Encrypt + system mail sender

# SMTP for login codes (any provider; a free tier is enough for staff logins)
SMTP_HOST=smtp-relay.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME="HealthConnect CRM"

# Backups: age public key (generate on YOUR laptop: age-keygen -o backup.agekey; keep that file offline)
BACKUP_AGE_RECIPIENT=age1...
# Optional off-site copy, rclone remote:path (configure deploy/supabase/rclone.conf), e.g. ocis3:crm-backups
BACKUP_RCLONE_REMOTE=
