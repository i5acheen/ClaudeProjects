---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import { solutions } from "../config/site";
---

<section id="solutions" class="section" aria-labelledby="solutions-title">
  <div class="container-x">
    <SectionHeading id="solutions-title" eyebrow="The fix" title={solutions.title} intro={solutions.intro} />
    <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {solutions.items.map((s) => (
        <li class="card flex flex-col" data-reveal>
          <span class="flex size-12 items-center justify-center rounded-xl bg-teal-700 text-cream">
            <Icon name={s.icon} />
          </span>
          <h3 class="mt-5 text-xl font-semibold text-teal-800">{s.title}</h3>
          <p class="mt-2 flex-1 leading-relaxed text-muted">{s.text}</p>
          <p class="mt-5 flex items-start gap-2 rounded-xl bg-teal-50 p-3 font-medium text-teal-800">
            <Icon name="ArrowRight" class="mt-0.5 size-5 shrink-0 text-saffron-700" />
            <span>{s.outcome}</span>
          </p>
        </li>
      ))}
      <li class="flex flex-col justify-center rounded-2xl bg-teal-800 p-6 text-cream" data-reveal>
        <h3 class="text-xl font-semibold">Something else slowing you down?</h3>
        <p class="mt-2 leading-relaxed text-cream/80">These are just the most common ones. Tell us your problem and we'll tell you honestly if it can be automated.</p>
        <a href="#contact" class="btn btn-saffron mt-5 self-start">Describe your problem <Icon name="ArrowRight" class="size-5" /></a>
      </li>
    </ul>
  </div>
</section>
