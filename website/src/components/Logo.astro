---
import { business } from "../config/site";
interface Props { light?: boolean }
const { light = false } = Astro.props;
---

<a href="/" class="flex min-h-12 items-center gap-2.5" aria-label={`${business.name}, home`}>
  <svg class="size-9 shrink-0" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <rect width="40" height="40" rx="11" fill={light ? "#ffffff" : "#111827"} />
    <path d="M11 27.5l1.4-4.1A9 9 0 1 1 16 27z" fill="none" stroke={light ? "#111827" : "#ffffff"} stroke-width="2.4" stroke-linejoin="round" />
    <path d="M15.5 19.2l3 3 6-6.2" fill="none" stroke="#958dff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class:list={["text-xl leading-tight font-bold tracking-tight", light ? "text-white" : "text-ink"]}>{business.name}</span>
</a>
