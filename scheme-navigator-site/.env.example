# ── Public (shown on the site; baked in at build time — redeploy after changing) ──
# Full site URL, no trailing slash. Used for canonical URLs, sitemap and social cards.
NEXT_PUBLIC_SITE_URL=https://www.example.org
# WhatsApp number, digits only with country code (no +, no spaces): 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Phone number as people should dial it: +919876543210
NEXT_PUBLIC_PHONE=
# Contact email
NEXT_PUBLIC_EMAIL=

# ── Server only (secret — never prefix with NEXT_PUBLIC_) ──
# Google Apps Script web app URL (see README → "Google Sheet setup")
SHEET_WEBHOOK_URL=
# Long random string. Must equal WEBHOOK_SECRET in the Apps Script's Script properties.
SHEET_WEBHOOK_SECRET=

# ── Optional analytics (load only after the visitor accepts the consent banner) ──
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# ── Build checks ──
# A production build FAILS while any [PLACEHOLDER] remains or a required variable above is empty.
# Set to 1 only for preview deployments that intentionally still have placeholders.
ALLOW_PLACEHOLDERS=
