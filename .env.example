# Reddit API credentials
# Create a "script" app at https://www.reddit.com/prefs/apps to get these.
# See README.md for the full walkthrough.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Required by Reddit's API rules. Format: "<platform>:<app id>:<version> (by /u/<your username>)"
REDDIT_USER_AGENT=social-intel-mcp-server:v0.1.0 (by /u/your_username)

# YouTube Data API v3 key (added in a later step)
# YOUTUBE_API_KEY=

# Path to the SQLite cache database file (optional, defaults to ./data/cache.sqlite)
# CACHE_DB_PATH=./data/cache.sqlite
