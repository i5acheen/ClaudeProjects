# Copy this file to .env and fill in real values. NEVER commit .env.
# On Render, set these under Service → Environment instead.

# ---------- WhatsApp Cloud API (Meta developer dashboard → your app → WhatsApp → API Setup) ----------
# Use a permanent System User token in production (temporary tokens expire in 24h)
WHATSAPP_TOKEN=
# "Phone number ID" (NOT the phone number itself)
PHONE_NUMBER_ID=
# Any random string you choose; paste the same value in the Meta webhook settings
VERIFY_TOKEN=
# App settings → Basic → App secret (used to validate X-Hub-Signature-256)
APP_SECRET=
GRAPH_API_VERSION=v26.0
# Only when using a BSP/partner (e.g. 360dialog) instead of Meta directly:
#   WHATSAPP_API_URL = the partner's "send message" endpoint, e.g. https://waba-v2.360dialog.io/messages
#   WHATSAPP_AUTH_HEADER = header name for the partner's API key, e.g. D360-API-KEY (WHATSAPP_TOKEN holds the key)
#   WEBHOOK_URL_KEY = a long random secret; give the partner the webhook URL https://<bot>/webhook?key=<this value>
#                     (partners don't sign webhooks with your Meta App secret)
WHATSAPP_API_URL=
WHATSAPP_AUTH_HEADER=
WEBHOOK_URL_KEY=

# ---------- LLMs: free open-source models first, Gemini last ----------
# Set at least one key. Providers without a key are skipped automatically.
# https://openrouter.ai/keys  (free ":free" models; a one-time $10 credit raises the limit to 1000 req/day)
OPENROUTER_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the order (provider:model, comma-separated). Default:
# LLM_CHAIN=openrouter:google/gemma-4-31b-it:free,groq:openai/gpt-oss-120b,openrouter:qwen/qwen3.8-27b:free,cerebras:gpt-oss-120b,openrouter:nvidia/nemotron-3-super-120b-a12b:free,gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite,gemini:gemini-3.5-flash

# ---------- Storage ----------
# Postgres (e.g. Neon free tier) so chat memory survives restarts. Leave empty to use SQLite.
DATABASE_URL=
SQLITE_PATH=data/conversations.db
# How many past messages per user are sent to the model as context
HISTORY_LIMIT=15

# ---------- Google Sheets lead log (optional) ----------
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads

# ---------- Google Calendar for appointment slots (optional) ----------
# The clinic's calendar ID (often its Gmail address). Share that calendar with the service-account
# email with "Make changes to events". Clinic hours/slots are set in knowledge/flows.yaml → schedule.
GOOGLE_CALENDAR_ID=

# ---------- Alerts to the clinic team (optional) ----------
# WhatsApp number (with country code) to notify about hot/confirmed leads.
# Note: free-form WhatsApp alerts arrive only if this number messaged the bot in the last 24h.
ALERT_PHONE=
# Email alerts (e.g. Gmail with an App Password: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587)
ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------- App ----------
# Clinic number shown in the "technical issue" fallback message
CLINIC_PHONE=+91 99711 21273
# Max messages per user per window (protects LLM quota from spam)
RATE_LIMIT_COUNT=20
RATE_LIMIT_WINDOW_SECONDS=600
# Coexistence: after staff reply from the WhatsApp Business app, the bot stays quiet for this many hours
HUMAN_HANDOFF_HOURS=12
# Test pages /diag/llm and /diag/chat (keep false in production)
ENABLE_DIAG=false
LOG_LEVEL=INFO
