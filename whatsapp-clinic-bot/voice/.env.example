# Neha voice agent: copy to .env and fill in. Never commit .env.

# Speech (Sarvam: listening + Marathi voice). Free credit on sign-up: https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Conversation brain + call-result extraction (free Gemini key from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=
# Optional: try another Gemini model or Sarvam voice without code changes
# VOICE_LLM_MODEL=gemini-3.5-flash-lite
# VOICE_TTS_VOICE=kavya

# Phone line (Plivo). Indian number needed for real patient calls.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

# Public https URL of this service (e.g. https://neha-voice.example.com), used for Plivo callbacks
PUBLIC_URL=

# Protects POST /calls. Generate one: openssl rand -hex 24
VOICE_API_TOKEN=

# Where call results go (the WhatsApp bot endpoint, added in the next step) + shared signing secret
RESULT_WEBHOOK_URL=
RESULT_WEBHOOK_SECRET=

# Calling hours in IST (calls outside are refused)
CALL_START_HOUR=9
CALL_END_HOUR=20

# Laptop-microphone test (local only; keep false on the server)
ENABLE_MIC_TEST=false
TEST_PATIENT_NAME=सचिन
