# SQLite database file used by Prisma
DATABASE_URL="file:./dev.db"

# Random secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Optional. Enables the AI policy-drafting feature (Anthropic API key,
# https://console.anthropic.com/). Every other feature works without it —
# the policy-drafting page just shows a "not configured" notice.
ANTHROPIC_API_KEY=
