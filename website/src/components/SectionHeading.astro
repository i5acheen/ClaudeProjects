---
import { hl } from "../lib/text";
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  id: string;
  center?: boolean;
  light?: boolean;
}
const { eyebrow, title, intro, id, center = true, light = false } = Astro.props;
---

<div class:list={["max-w-2xl", center && "mx-auto text-center", light && "on-dark"]} data-reveal>
  {eyebrow && <p class:list={["eyebrow", light && "!text-lavender-300"]}>{eyebrow}</p>}
  <h2 id={id} class:list={["h2 mt-3", light && "!text-white"]} set:html={hl(title)} />
  {intro && <p class:list={["lead", light && "!text-white/70"]}>{intro}</p>}
</div>
