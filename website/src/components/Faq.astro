---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import { faq } from "../config/site";
import { ph } from "../lib/text";
---

<section id="faq" class="section bg-sand" aria-labelledby="faq-title">
  <div class="container-x max-w-3xl">
    <SectionHeading id="faq-title" eyebrow="FAQ" title={faq.title} />
    <div class="mt-10 space-y-3">
      {faq.items.map((item, i) => (
        <details class="group rounded-2xl border border-line bg-white shadow-sm" open={i === 0} data-reveal>
          <summary class="flex min-h-14 cursor-pointer items-center justify-between gap-4 px-5 py-4 text-left text-lg font-semibold text-teal-800">
            {item.q}
            <Icon name="ChevronDown" class="faq-chevron size-5 shrink-0 text-teal-600 transition" />
          </summary>
          <p class="px-5 pb-5 leading-relaxed text-muted" set:html={ph(item.a)} />
        </details>
      ))}
    </div>
  </div>
</section>
