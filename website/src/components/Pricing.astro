---
import Icon from "./Icon.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import SectionHeading from "./SectionHeading.astro";
import { pricing, whatsappLink } from "../config/site";
---

<section id="pricing" class="section" aria-labelledby="pricing-title">
  <div class="container-x">
    <SectionHeading id="pricing-title" eyebrow={pricing.eyebrow} title={pricing.title} />
    <ul class="mt-12 grid gap-4 sm:mt-14 md:grid-cols-3 md:gap-6">
      {pricing.items.map((p) => (
        <li class="lift rounded-[2rem] bg-lavender-50 p-7" data-reveal>
          <span class="flex size-14 items-center justify-center rounded-2xl bg-lavender-100 text-lavender-600"><Icon name={p.icon} class="size-7" strokeWidth={1.75} /></span>
          <h3 class="mt-6 text-xl font-bold text-ink">{p.title}</h3>
          <p class="mt-2 inline-flex rounded-full bg-white px-3 py-1 text-xs font-semibold tracking-wide text-lavender-600 uppercase">{p.tag}</p>
          <p class="mt-3 text-muted">{p.text}</p>
        </li>
      ))}
    </ul>
    <div class="mt-10 flex flex-col items-center gap-5 text-center" data-reveal>
      <p class="flex items-center gap-2 text-sm text-muted"><Icon name="Info" class="size-4 shrink-0 text-lavender-500" />{pricing.note}</p>
      <a href={whatsappLink("Hi! I'd like a free quote for automating part of my business.")} target="_blank" rel="noopener" class="btn btn-dark text-lg">
        <WhatsAppIcon class="size-5" /> {pricing.cta}
      </a>
    </div>
  </div>
</section>
