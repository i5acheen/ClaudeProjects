# Copy this file to .env.local and fill in the values (see README.md).

# A long random string used to encrypt the sign-in cookie.
# Create one with:  npx auth secret   (or any 32+ random characters)
AUTH_SECRET=

# From Google Cloud Console → APIs & Services → Credentials → your OAuth client.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: only these Google accounts may sign in (comma separated).
# Leave empty to allow anyone you added as a test user in Google Cloud.
ALLOWED_EMAILS=
