---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import { services } from "../config/site";
---

<section id="services" class="section" aria-labelledby="services-title">
  <div class="container-x">
    <SectionHeading id="services-title" eyebrow={services.eyebrow} title={services.title} />
    <ul class="no-scrollbar -mx-4 mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 sm:mt-12 md:mx-0 md:grid md:grid-cols-2 md:overflow-visible md:px-0 md:pb-0 lg:grid-cols-3" aria-label="Services">
      {services.items.map((s, i) => (
        <li class:list={["lift group flex w-[85%] shrink-0 snap-center flex-col rounded-3xl md:w-auto border border-line bg-white p-6 sm:p-7", i === 0 && "lg:col-span-2 lg:bg-teal-800 lg:text-cream lg:border-teal-800"]} data-reveal>
          <div class="flex items-center justify-between gap-3">
            <span class:list={["flex size-12 items-center justify-center rounded-2xl bg-teal-700 text-cream", i === 0 && "lg:bg-saffron-400 lg:text-ink"]}>
              <Icon name={s.icon} />
            </span>
            <span class:list={["inline-flex items-center gap-1 rounded-full bg-saffron-100 px-3 py-1 text-xs font-semibold text-saffron-700", i === 0 && "lg:bg-cream/10 lg:text-saffron-300"]}>
              <Icon name="X" class="size-3.5" strokeWidth={3} />{s.problem}
            </span>
          </div>
          <h3 class:list={["mt-6 text-2xl font-semibold text-teal-800", i === 0 && "lg:text-cream lg:text-3xl"]}>{s.title}</h3>
          <p class:list={["mt-2 flex-1 leading-relaxed text-muted", i === 0 && "lg:text-cream/75 lg:text-lg lg:max-w-lg"]}>{s.text}</p>
          <p class:list={["mt-5 flex items-center gap-2 font-semibold text-teal-700", i === 0 && "lg:text-saffron-300"]}>
            <Icon name="TrendingUp" class="size-5" />{s.outcome}
          </p>
        </li>
      ))}

    </ul>
    <p class="mt-3 text-center text-sm text-muted md:hidden" aria-hidden="true">Swipe to see more →</p>
      <div class="mt-4 flex flex-col items-start justify-between gap-4 rounded-3xl border-2 border-dashed border-saffron-400 bg-saffron-100/50 p-6 sm:flex-row sm:items-center sm:p-7" data-reveal>
        <div>
          <h3 class="text-xl font-semibold text-teal-800">{services.more.title}</h3>
          <p class="mt-1 text-muted">{services.more.text}</p>
        </div>
        <a href="#contact" class="btn shrink-0 bg-teal-800 text-cream hover:bg-teal-900">{services.more.cta} <Icon name="ArrowRight" class="size-5" /></a>
      </div>
  </div>
</section>
