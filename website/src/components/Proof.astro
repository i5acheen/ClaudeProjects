---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import { proof } from "../config/site";
import { ph } from "../lib/text";
const cs = proof.caseStudy;
---

<section id="proof" class="section" aria-labelledby="proof-title">
  <div class="container-x">
    <SectionHeading id="proof-title" eyebrow="Demos & results" title={proof.title} intro={proof.intro} />

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {proof.videos.map((v) =>
        v.id ? (
          <div class="overflow-hidden rounded-2xl border border-line bg-white shadow-sm" data-reveal>
            <button
              type="button"
              class="yt group relative block aspect-video w-full bg-teal-900"
              data-id={v.id}
              data-title={v.title}
              aria-label={`Play video: ${v.title}`}
            >
              <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" width="480" height="360" class="size-full object-cover opacity-90 transition group-hover:opacity-100" />
              <span class="absolute inset-0 m-auto flex size-16 items-center justify-center rounded-full bg-saffron-400 text-ink shadow-lg transition group-hover:scale-110">
                <Icon name="Play" class="ml-1 size-7" />
              </span>
            </button>
            <p class="p-4 font-semibold text-teal-800">{v.title}</p>
          </div>
        ) : (
          <div class="flex min-h-56 flex-col items-center justify-center gap-3 rounded-2xl border-2 border-dashed border-saffron-400 bg-saffron-100/50 p-6 text-center" data-reveal>
            <Icon name="Play" class="size-10 text-saffron-700" />
            <p class="font-semibold" set:html={ph(v.title)} />
            <p class="text-sm text-muted">Add the YouTube video ID in <code>src/config/site.ts</code></p>
          </div>
        ),
      )}
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-[1.4fr_1fr]">
      <article class="card" data-reveal aria-labelledby="case-title">
        <p class="eyebrow">{cs.label}</p>
        <h3 id="case-title" class="mt-2 text-2xl font-semibold text-teal-800" set:html={ph(cs.business)} />
        <dl class="mt-5 grid gap-4 sm:grid-cols-3">
          {[["The problem", cs.problem, "CircleAlert"], ["What we built", cs.solution, "Hammer"], ["The result", cs.result, "TrendingUp"]].map(([k, v, icon]) => (
            <div class="rounded-xl bg-sand p-4">
              <dt class="flex items-center gap-2 font-semibold text-teal-800"><Icon name={icon} class="size-5 text-teal-600" />{k}</dt>
              <dd class="mt-2 text-muted" set:html={ph(v)} />
            </div>
          ))}
        </dl>
      </article>
      <figure class="card flex flex-col justify-center" data-reveal>
        <Icon name="Quote" class="size-8 text-saffron-400" />
        <blockquote class="mt-3 text-lg leading-relaxed" set:html={ph(proof.testimonial.quote)} />
        <figcaption class="mt-4 text-sm font-semibold text-muted" set:html={`— ${ph(proof.testimonial.author)}`} />
      </figure>
    </div>
  </div>
</section>

<script>
  // Load YouTube only when the visitor taps play (keeps the page fast & cookie-free until then)
  document.querySelectorAll<HTMLButtonElement>(".yt").forEach((btn) => {
    btn.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.id}?autoplay=1&rel=0`;
      iframe.title = btn.dataset.title || "Demo video";
      iframe.allow = "accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      iframe.className = "aspect-video w-full";
      btn.replaceWith(iframe);
    });
  });
</script>
