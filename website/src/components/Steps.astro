---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import { steps, bookingLink } from "../config/site";
---

<section id="how" class="section bg-sand" aria-labelledby="how-title">
  <div class="container-x">
    <SectionHeading id="how-title" eyebrow={steps.eyebrow} title={steps.title} />
    <div class="relative mt-12">
    <div aria-hidden="true" class="absolute top-7 right-[12%] left-[12%] hidden h-px bg-gradient-to-r from-transparent via-saffron-400 to-transparent lg:block"></div>
    <ol class="relative grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {steps.items.map((s, i) => (
        <li class="relative flex items-start gap-4 rounded-2xl bg-white p-5 lg:flex-col lg:items-center lg:bg-transparent lg:p-0 lg:text-center" data-reveal>
          <span class="relative flex size-14 shrink-0 items-center justify-center rounded-2xl bg-teal-800 text-cream shadow-lg shadow-teal-900/20">
            <Icon name={s.icon} />
            <span class="absolute -top-2 -right-2 flex size-6 items-center justify-center rounded-full bg-saffron-400 text-xs font-bold text-ink" aria-hidden="true">{i + 1}</span>
          </span>
          <div>
            <h3 class="text-lg font-semibold text-teal-800 lg:mt-4"><span class="sr-only">Step {i + 1}: </span>{s.title}</h3>
            <p class="mt-1 text-muted">{s.text}</p>
          </div>
        </li>
      ))}
    </ol>
    </div>
    <div class="mt-10 text-center" data-reveal>
      <a href={bookingLink} target="_blank" rel="noopener" class="btn btn-outline">
        <Icon name="CalendarCheck" class="size-5" /> Book your free call
      </a>
    </div>
  </div>
</section>
