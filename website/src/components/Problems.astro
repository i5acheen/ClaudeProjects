---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import { problems } from "../config/site";
---

<section id="problems" class="section bg-sand" aria-labelledby="problems-title">
  <div class="container-x">
    <SectionHeading id="problems-title" eyebrow="The everyday problem" title={problems.title} intro={problems.intro} />
    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-6">
      {problems.items.map((p, i) => (
        <li class:list={["card flex gap-4 lg:col-span-2", i === 3 && "lg:col-start-2", i === 4 && "sm:col-span-2"]} data-reveal>
          <span class="flex size-12 shrink-0 items-center justify-center rounded-xl bg-saffron-100 text-saffron-700">
            <Icon name={p.icon} />
          </span>
          <div>
            <h3 class="text-xl font-semibold text-teal-800">{p.title}</h3>
            <p class="mt-2 leading-relaxed text-muted">{p.text}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="mt-10 text-center text-lg font-medium text-teal-800" data-reveal>
      If even one of these hit home, there's a simple fix. ↓
    </p>
  </div>
</section>
