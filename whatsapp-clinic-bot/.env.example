# Copy this file to .env and fill in real values. NEVER commit .env.

# ---------- WhatsApp Cloud API (Meta developer dashboard → your app → WhatsApp → API Setup) ----------
# Temporary (24h) or permanent System User access token
WHATSAPP_TOKEN=
# "Phone number ID" of the test number (NOT the phone number itself)
PHONE_NUMBER_ID=
# Any random string you choose; paste the same value in the Meta webhook settings
VERIFY_TOKEN=
# App settings → Basic → App secret (used to validate X-Hub-Signature-256)
APP_SECRET=
# Graph API version
GRAPH_API_VERSION=v23.0

# ---------- Google Gemini (https://aistudio.google.com/apikey) ----------
GEMINI_API_KEY=
# Current free-tier Flash model. If you get 404/429 errors, try gemini-2.5-flash or gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# ---------- Google Sheets (service account) ----------
# Path to the service-account JSON key you downloaded from Google Cloud
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
# The long ID in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# Tab name inside the spreadsheet (created automatically if missing)
GOOGLE_SHEET_TAB=Leads

# ---------- App ----------
SQLITE_PATH=data/conversations.db
# How many past messages per user are sent to the model as context
HISTORY_LIMIT=15
# Shown to the user only if the AI is unavailable
CLINIC_PHONE=+91 99711 21273
LOG_LEVEL=INFO
