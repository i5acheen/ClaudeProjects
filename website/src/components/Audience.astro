---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import { audience } from "../config/site";
---

<section id="who" class="section bg-sand" aria-labelledby="who-title">
  <div class="container-x">
    <SectionHeading id="who-title" eyebrow="Made for small & medium businesses" title={audience.title} intro={audience.intro} />
    <ul class="mt-12 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
      {audience.items.map((a, i) => (
        <li class:list={["flex flex-col items-center gap-3 rounded-2xl border border-line bg-white px-3 py-6 text-center shadow-sm", i === audience.items.length - 1 && "col-span-2 sm:col-span-1"]} data-reveal>
          <span class="flex size-14 items-center justify-center rounded-full bg-teal-50 text-teal-700">
            <Icon name={a.icon} class="size-7" />
          </span>
          <span class="font-semibold text-teal-800">{a.label}</span>
        </li>
      ))}
      <li class="col-span-2 flex items-center justify-center gap-3 rounded-2xl border-2 border-dashed border-saffron-400 bg-saffron-100/60 px-4 py-6 text-center sm:col-span-2 lg:col-span-1" data-reveal>
        <span class="font-semibold text-saffron-700">{audience.more}</span>
      </li>
    </ul>
  </div>
</section>
