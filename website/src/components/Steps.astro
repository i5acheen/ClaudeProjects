---
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
import { steps, bookingLink } from "../config/site";
---

<section id="how" class="section bg-mist" aria-labelledby="how-title">
  <div class="container-x">
    <SectionHeading id="how-title" title={steps.title} intro={steps.intro} />
    <ol class="mt-12 grid gap-4 sm:mt-14 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {steps.items.map((s, i) => (
        <li class="lift rounded-[2rem] border border-lavender-200 bg-white p-7 text-center" data-reveal>
          <span class="block text-6xl font-bold tracking-tight text-lavender-500" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="mt-4 text-lg font-bold text-ink"><span class="sr-only">Step {i + 1}: </span>{s.title}</h3>
          <p class="mt-1 text-muted">{s.text}</p>
        </li>
      ))}
    </ol>
    <div class="mt-12 text-center" data-reveal>
      <a href={bookingLink} target="_blank" rel="noopener" class="btn btn-lavender">
        <Icon name="CalendarCheck" class="size-5" /> Book your free call
      </a>
    </div>
  </div>
</section>
