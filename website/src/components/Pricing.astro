---
import Icon from "./Icon.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import SectionHeading from "./SectionHeading.astro";
import { pricing, whatsappLink } from "../config/site";
---

<section id="pricing" class="section bg-sand" aria-labelledby="pricing-title">
  <div class="container-x">
    <SectionHeading id="pricing-title" eyebrow="Pricing" title={pricing.title} intro={pricing.intro} />
    <ul class="mt-12 grid gap-5 md:grid-cols-3">
      {pricing.items.map((p) => (
        <li class="card flex flex-col" data-reveal>
          <span class="flex size-12 items-center justify-center rounded-xl bg-teal-50 text-teal-700"><Icon name={p.icon} /></span>
          <h3 class="mt-5 text-xl font-semibold text-teal-800">{p.title}</h3>
          <p class="mt-2 inline-flex self-start rounded-full bg-saffron-100 px-3 py-1 text-sm font-semibold text-saffron-700">{p.tag}</p>
          <p class="mt-3 leading-relaxed text-muted">{p.text}</p>
        </li>
      ))}
    </ul>
    <p class="mx-auto mt-8 flex max-w-3xl items-start gap-2 text-muted" data-reveal>
      <Icon name="Info" class="mt-0.5 size-5 shrink-0 text-teal-600" />
      <span>{pricing.note}</span>
    </p>
    <div class="mt-8 text-center" data-reveal>
      <a href={whatsappLink("Hi! I'd like a free quote for automating part of my business.")} target="_blank" rel="noopener" class="btn btn-whatsapp text-lg">
        <WhatsAppIcon class="size-6" /> {pricing.cta}
      </a>
    </div>
  </div>
</section>
