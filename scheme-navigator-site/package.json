{
  "name": "maharashtra-health-connect-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-placeholders.mjs && node scripts/check-i18n.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "i18n:export": "node scripts/check-i18n.mjs --export",
    "qr": "node scripts/make-qr.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.9.9",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
